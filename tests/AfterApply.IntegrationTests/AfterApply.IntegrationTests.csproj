<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AfterApply.Infrastructure\AfterApply.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AfterApply.Api\AfterApply.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.FakeGcsServer" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The CV scan fixtures are real files, generated in-process: a PDF built with PdfPig's
         own writer and a .docx built with the OpenXml SDK. Checking binary fixtures into the
         repository would mean nobody can see what a test is asserting without opening a
         viewer — and a two-column layout is exactly the kind of thing that has to be read
         as coordinates to be understood. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Classes run in parallel (maxParallelThreads=0: one thread per logical CPU) since
         2026-09-26; each has its own database clone, Redis database and backplane channel, and
         the containers are shared process-wide (SharedInfrastructure.GetAsync). Classes that touch
         process-wide state join SerialTestCollection. diagnosticMessages+longRunningTestSeconds
         make xunit name any test still running after 30 s while the run is in progress. -->
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>