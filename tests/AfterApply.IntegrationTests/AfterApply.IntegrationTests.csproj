<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AfterApply.Infrastructure\AfterApply.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AfterApply.Api\AfterApply.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.FakeGcsServer" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The CV scan fixtures are real files, generated in-process: a PDF built with PdfPig's
         own writer and a .docx built with the OpenXml SDK. Checking binary fixtures into the
         repository would mean nobody can see what a test is asserting without opening a
         viewer — and a two-column layout is exactly the kind of thing that has to be read
         as coordinates to be understood. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every test class here creates its own dedicated Postgres Testcontainers instance and
         has no [Collection] attribute, so xUnit's default (parallelizeTestCollections=true,
         maxParallelThreads=Environment.ProcessorCount) lets all ~16 of them boot containers at
         once — enough concurrent container startups to stall the shared podman VM for minutes.
         Capping the thread count bounds how many containers start simultaneously. -->
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Canned JSearch (RapidAPI) bodies, shared by both test projects. Shapes captured from the
         provider's playground; values are illustrative. -->
    <EmbeddedResource Include="..\Fixtures\JobSearch\*.json" LogicalName="Fixtures.JobSearch.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
