bin/
obj/
# Rider on macOS occasionally creates a literal "bin\Debug" folder (backslash as part of the
# name, not a path separator) as a build-host cache — bin/ above doesn't match it since the name
# isn't exactly "bin".
bin\\Debug/
/packages/
riderModule.iml
/_ReSharper.Caches/

# macOS
.DS_Store

# Environment / local secrets
.env
.env.prod

# EF Core (once migrations exist, Sprint 1+)
*.db
*.db-shm
*.db-wal

# Build-time OpenAPI output (postman/scripts/generate-collection.js's input) — regenerated by
# every `dotnet build`, never hand-edited, not meaningful to diff in review.
/postman/openapi/
# Postman collection is likewise a generated artifact — CI regenerates and pushes it to
# Postman Cloud; see postman/README.md.
/postman/collection.json
node_modules/
.wrangler/

# Rider
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf/

# Redis empty database dump file (generated by `dotnet run` in development, not meaningful to diff in review)
dump.rdb