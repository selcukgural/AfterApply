# Prod-profile secrets — copy to .env.prod (git-ignored) and fill in real
# values. Used with: docker compose --env-file .env.prod -f docker-compose.yml
# -f docker-compose.prod.yml up --build
# See DEPLOYMENT.md for the full explanation of each value.

POSTGRES_DB=afterapply
POSTGRES_USER=afterapply
# A real, generated secret — not the dev placeholder.
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# The origin the browser loads the frontend from — added to the API's CORS
# allow-list. No trailing slash.
WEB_ORIGIN=http://localhost:3000

# The origin the browser calls the API on — baked into the frontend's build
# as NEXT_PUBLIC_API_BASE_URL. No trailing slash.
API_ORIGIN=http://localhost:8080

# AI Job Matching (Sprint 8) — from your own OpenAI account. See README.md
# "AI Job Matching Setup". Leave the placeholder below and the feature
# simply stays inert (not fail-fast) until a real key is set.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# Forgot-password email — from your own Resend account (resend.com), sending domain
# mail.ekariyerim.com. Leave the placeholder below and the feature stays inert (reset requests
# succeed but no email goes out) until a real key is set.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY

# Sign in with Google — an OAuth 2.0 client of type "Web application" from your own Google Cloud
# project (APIs & Services -> Credentials). Its authorized redirect URIs must include
# <WEB_ORIGIN>/tr/auth/google/callback and <WEB_ORIGIN>/en/auth/google/callback. Leave BOTH blank
# and the feature stays inert: the button is hidden and the /api/auth/google* endpoints answer 404.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with LinkedIn — a LinkedIn Developer app (with the "Sign In with LinkedIn using OpenID
# Connect" product enabled) tied to your own LinkedIn Page. Its authorized redirect URLs must include
# <WEB_ORIGIN>/tr/auth/linkedin/callback and <WEB_ORIGIN>/en/auth/linkedin/callback — LinkedIn requires
# HTTPS for these, so unlike Google this cannot be tested against a plain http://localhost redirect.
# Leave BOTH blank and the feature stays inert: the button is hidden and the /api/auth/linkedin*
# endpoints answer 404.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Error tracking (Sprint 13) — from your own Sentry project (Settings ->
# Client Keys / DSN). Unlike the placeholders above, leave this genuinely
# BLANK (not a REPLACE_WITH_ string) to disable — the Sentry SDK treats an
# empty Dsn as "disabled", a non-empty fake string would instead try (and
# fail) to send events on every request.
SENTRY_DSN=
# Same DSN, exposed to the browser bundle (Next.js requires the
# NEXT_PUBLIC_ prefix for client-side env vars, baked in at build time).
NEXT_PUBLIC_SENTRY_DSN=

# Feedback -> GitHub Issues mirror (2026-09-07). Off unless all three are set: the in-app panel
# always stores feedback in our own database, and this only adds a copy in a GitHub issue so
# triage (labels, milestones, the project board) comes for free. The repository MUST be private —
# the issue body carries whatever a user typed. The token is a fine-grained PAT with issues:write
# on that one repository and nothing else; the mirror deliberately omits the sender's identity and
# reply address, so answering someone means looking the feedback id up in FeedbackEntries.
# Turning it on is also a privacy-policy change: /privacy has to name GitHub as a recipient and the
# mirror as a transfer abroad before the flag flips, not after.
Feedback__GitHub__Enabled=false
Feedback__GitHub__Repository=
Feedback__GitHub__Token=
# GitHub username each mirrored issue is assigned to, so a new report shows up in that
# person's "Assigned to me" instead of waiting to be noticed. Blank leaves them unassigned.
Feedback__GitHub__Assignee=
