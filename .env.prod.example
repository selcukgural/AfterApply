# Prod-profile secrets — copy to .env.prod (git-ignored) and fill in real
# values. Used with: docker compose --env-file .env.prod -f docker-compose.yml
# -f docker-compose.prod.yml up --build
# See DEPLOYMENT.md for the full explanation of each value.

POSTGRES_DB=afterapply
POSTGRES_USER=afterapply
# A real, generated secret — not the dev placeholder.
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# The origin the browser loads the frontend from — added to the API's CORS
# allow-list. No trailing slash.
WEB_ORIGIN=http://localhost:3000

# The origin the browser calls the API on — baked into the frontend's build
# as NEXT_PUBLIC_API_BASE_URL. No trailing slash.
API_ORIGIN=http://localhost:8080
