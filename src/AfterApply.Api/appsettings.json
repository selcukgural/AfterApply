{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "AfterApply",
    "Audience": "AfterApply.Api",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 30
  },
  "Imports": {
    "MaxFileSizeBytes": 5242880,
    "MaxRowCount": 5000,
    "MaxZipSizeBytes": 52428800,
    "MaxZipEntryCount": 500
  },
  "Notifications": {
    "FollowUpThresholdDays": 7,
    "GhostingThresholdDays": 30,
    "ScanCronExpression": "0 3 * * *"
  },
  "AllowedHosts": "*"
}
