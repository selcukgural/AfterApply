{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "AfterApply",
    "Audience": "AfterApply.Api",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 30
  },
  "Imports": {
    "MaxFileSizeBytes": 5242880,
    "MaxRowCount": 5000,
    "MaxZipSizeBytes": 52428800,
    "MaxZipEntryCount": 500
  },
  "Notifications": {
    "FollowUpThresholdDays": 7,
    "GhostingThresholdDays": 30,
    "ScanCronExpression": "0 3 * * *"
  },
  "EmailForwarding": {
    "Enabled": true,
    "Domain": "application.ekariyerim.com",
    "WebhookSecret": "REPLACE_WITH_EMAIL_FORWARDING_WEBHOOK_SECRET"
  },
  "JobBoardDomains": {
    "Domains": [
      "linkedin.com", "indeed.com", "glassdoor.com", "ziprecruiter.com", "monster.com",
      "careerbuilder.com", "simplyhired.com", "dice.com", "wellfound.com", "hired.com", "xing.com",
      "greenhouse.io", "lever.co", "workable.com", "smartrecruiters.com", "icims.com",
      "taleo.net", "successfactors.com", "sapsf.com", "myworkdayjobs.com", "workday.com",
      "jobvite.com", "breezy.hr", "bamboohr.com", "ashbyhq.com", "personio.com", "personio.de",
      "recruitee.com", "teamtailor.com", "join.com", "freshteam.com", "jazzhr.com",
      "applytojob.com", "ultipro.com", "myworkforcenow.com", "paylocity.com", "paycomonline.com",
      "adp.com", "cornerstoneondemand.com", "phenompeople.com", "eightfold.ai",
      "kariyer.net", "secretcv.com", "isbul.net", "iskur.gov.tr", "yenibiris.com"
    ]
  },
  "OpenAI": {
    "ApiKey": "REPLACE_WITH_OPENAI_API_KEY",
    "Model": "gpt-4o-mini"
  },
  "Matching": {
    "Enabled": false
  },
  "Sentry": {
    "Dsn": ""
  },
  "CompanyIntelligence": {
    "Enabled": false,
    "HiddenBelow": 20,
    "VeryLowBelow": 50,
    "LowBelow": 200,
    "MediumBelow": 1000,
    "ResponseTimeCapDays": 30,
    "ResponsivenessWeight": 1.0,
    "ResponseTimeWeight": 1.0,
    "ClosureRateWeight": 1.0
  },
  "Companies": {
    "FuzzyMatchThreshold": 0.5,
    "MinQueryLength": 2,
    "MaxResults": 8
  },
  "AllowedHosts": "*"
}
