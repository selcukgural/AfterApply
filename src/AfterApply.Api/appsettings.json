{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "AfterApply",
    "Audience": "AfterApply.Api",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 30
  },
  "Imports": {
    "MaxFileSizeBytes": 5242880,
    "MaxRowCount": 5000,
    "MaxZipSizeBytes": 52428800,
    "MaxZipEntryCount": 500
  },
  "Notifications": {
    "FollowUpThresholdDays": 7,
    "GhostingThresholdDays": 30,
    "ScanCronExpression": "0 3 * * *"
  },
  "GoogleOAuth": {
    "ClientId": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET",
    "RedirectUri": "http://localhost:5151/api/email-integrations/gmail/callback"
  },
  "EmailIntegrations": {
    "SyncCronExpression": "0 * * * *",
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "OpenAI": {
    "ApiKey": "REPLACE_WITH_OPENAI_API_KEY",
    "Model": "gpt-4o-mini"
  },
  "Sentry": {
    "Dsn": ""
  },
  "CompanyIntelligence": {
    "Enabled": false,
    "HiddenBelow": 20,
    "VeryLowBelow": 50,
    "LowBelow": 200,
    "MediumBelow": 1000,
    "ResponseTimeCapDays": 30,
    "ResponsivenessWeight": 1.0,
    "ResponseTimeWeight": 1.0,
    "ClosureRateWeight": 1.0
  },
  "AllowedHosts": "*"
}
