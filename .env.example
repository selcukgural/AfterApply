POSTGRES_DB=afterapply
POSTGRES_USER=afterapply
POSTGRES_PASSWORD=changeme_local_only

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=changeme_local_only

# Optional — Sign in with Google (see README.md "Google Sign-In Setup"). Leave both empty and the
# feature stays inert (button hidden, /api/auth/google* answer 404).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Sign in with GitHub (see README.md "GitHub Sign-In Setup"). Same inert-until-set
# contract. Unlike LinkedIn this one CAN be exercised locally: register the callback under
# http://127.0.0.1:3000 (GitHub follows the OAuth RFC and prefers the loopback address over the
# name "localhost") and set App:WebBaseUrl to the same origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
