POSTGRES_DB=afterapply
POSTGRES_USER=afterapply
POSTGRES_PASSWORD=changeme_local_only

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=changeme_local_only

# Optional — Sign in with Google (see README.md "Google Sign-In Setup"). Leave both empty and the
# feature stays inert (button hidden, /api/auth/google* answer 404).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Sign in with GitHub (see README.md "GitHub Sign-In Setup"). Same inert-until-set
# contract. Unlike LinkedIn this one CAN be exercised locally: register the callback under
# http://127.0.0.1:3000 (GitHub follows the OAuth RFC and prefers the loopback address over the
# name "localhost") and set App:WebBaseUrl to the same origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Weekly job-source sweep (2026-09-12). Off by default; see DEPLOYMENT.md §13 before turning it
# on — the privacy policy names LinkedIn as a recipient of the user's criteria and must ship first.
JobSources__Enabled=false
# Vertex AI project for the fit scoring (empty = no model calls; the sweep still delivers unscored postings).
JobSources__Scoring__ProjectId=
# kariyer.net as the second source next to LinkedIn.
JobSources__KariyerNetEnabled=true

# PayTR iFrame payments for the Pro plan (2026-09-15). Off by default; DEPLOYMENT.md §15 is the
# switch-on recipe. The three merchant values are secrets — locally `dotnet user-secrets set
# "PayTr:MerchantId" ...` (see README) rather than this file.
PayTr__Enabled=false
PayTr__TestMode=true
# Prices in kuruş, KDV included (29900 = ₺299,00). Set before enabling.
PayTr__Plans__Monthly__AmountMinor=29900
PayTr__Plans__Yearly__AmountMinor=299000
# Local dev only: PayTR refuses private IPs as user_ip, so put your public IP here.
PayTr__DevUserIpOverride=
