<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below also pin a package nothing references directly. Needed for the
         Newtonsoft.Json entry: Hangfire.Core asks for >= 11.0.1, and in the API/Infrastructure
         projects EntityFrameworkCore.Design happened to drag the floor up to a safe 13.x — but
         Design is a development dependency whose assets don't flow to the test projects, so those
         resolved the literal 11.0.1, which carries GHSA-5crp-9r3c-p9vr (high). Pinning centrally
         fixes it everywhere instead of relying on that coincidence holding. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" />
    <!-- Caching (DECISIONS.md 2026-09-18 "Redis geri geldi"). The HybridCache abstract class the
         services depend on lives in Caching.Abstractions; FusionCache implements it (AsHybridCache)
         on top of the DI MemoryCache (L1), a Redis IDistributedCache (L2) and a Redis pub/sub
         backplane that fans every Remove/Set out to the other Cloud Run instances' L1s — the part
         Microsoft's own DefaultHybridCache does not have. StackExchange.Redis is pinned on the 2.x
         line explicitly because five packages below share it and transitive pinning is on. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.8.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.8.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.8.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <!-- Fixed-window counters in Redis (one Lua INCR per request), so a rate limit is one limit
         across every Cloud Run instance rather than one per instance (DECISIONS.md 2026-09-18).
         Wrapped by RedisFirstFixedWindowLimiter, which falls back to the in-memory limiter while
         Redis is unreachable — the library itself lets a Redis exception escape AcquireAsync. -->
    <PackageVersion Include="RedisRateLimiting.AspNetCore" Version="1.2.1" />
    <!-- SignalR backplane: an import job runs on whichever instance's Hangfire worker picked it
         up, the uploader's socket is on whichever instance served the page; without this the
         progress push never crossed between them. Same multiplexer as the cache. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <!-- Cross-instance mutex (Redis SET NX + Lua release). One consumer so far: company
         enrichment, so two workers do not fetch the same LinkedIn page at once. Not for anything
         Postgres already serialises — Hangfire's recurring jobs, unique indexes, advisory locks. -->
    <PackageVersion Include="DistributedLock.Redis" Version="1.1.1" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- Polly v8 through Microsoft's HttpClient integration, for the job-source client only: the
         one outbound call that runs unattended in a job and so has to decide by itself what to
         do about a dropped connection (retry, briefly) versus a 429/403 (stop, and do not retry —
         see LinkedInJobSourceClient). Same version line the Caching.Hybrid package used to sit on. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="4.15.0" />
    <!-- CV text extraction (V6). PdfPig is Apache-2.0 and pure managed code — it gives words
         with their coordinates, which is what the multi-column check reads; DocumentFormat.OpenXml
         is the same story for .docx, headers and footers included. Neither shells out to a
         converter, so nothing an uploaded file contains ever reaches a process boundary. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Blog HTML (2026-09-19). Ganss's HtmlSanitizer parses with AngleSharp and keeps only what
         its allowlists name — tags, attributes, CSS properties, URL schemes — which is the one
         control between the editor's markup and the public page's dangerouslySetInnerHTML. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.995" />
    <!-- Vertex AI is called over its REST endpoint (see VertexCvReviewProvider), so the only
         Google package needed is the one that turns Application Default Credentials into a
         bearer token. Referenced directly rather than leant on transitively through
         Google.Cloud.Storage.V1: a dependency the code calls into is a dependency the project
         file should name. -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.74.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.FakeGcsServer" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.24" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.9.0" />
    <!-- Transitive-only (Hangfire.Core, EntityFrameworkCore.Design) — pinned, not referenced.
         See CentralPackageTransitivePinningEnabled above. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>