{
  "manifest_version": 3,
  "name": "AfterApply — LinkedIn Import",
  "version": "0.1.0",
  "description": "Track a LinkedIn job application in AfterApply with one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AfterApply"
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "https://afterapply-api-188370748893.europe-west1.run.app/*",
    "https://api.ekariyerim.com/*"
  ]
}
