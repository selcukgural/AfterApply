{
  "manifest_version": 3,
  "name": "e-kariyerim — Job Import",
  "version": "0.4.0",
  "description": "Get your job applications into e-kariyerim — one click from LinkedIn/kariyer.net, or by forwarding emails.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "e-kariyerim",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.kariyer.net/*",
    "https://mail.google.com/*",
    "https://afterapply-api-188370748893.europe-west1.run.app/*",
    "https://api.ekariyerim.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["local-filter-config.js", "gmail-scan.js"],
      "run_at": "document_idle"
    }
  ]
}
