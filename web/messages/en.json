  "privacy": {
    "title": "Privacy Policy",
    "lastUpdated": "Last updated: 2026",
    "dataCollection": {
      "title": "What data we collect and why",
      "intro": "AfterApply is a personal tool that helps you track your job applications. To provide the service, we process the following data:",
      "item1": "Account information: first name, last name, email address, password (stored hashed).",
      "item2": "Application data you enter or import: company, job listing, application status, dates, and notes.",
      "item3": "Reminders derived from this data (follow-up suggestions, no-response alerts).",
      "outro": "This data is used solely to provide you with application tracking and personal analytics features."
    },
    "retention": {
      "title": "Retention period",
      "body": "Your data is kept until you delete your account. No automatic time-based deletion is applied."
    },
    "rights": {
      "title": "Your rights",
      "before": "You can export a copy of your data or permanently delete your account at any time. You can do this from the",
